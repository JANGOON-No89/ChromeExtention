{
	"manifest_version": 3,
	"name": "DCInside Image Downloader",
	"version": "0.1",
	"description": "DC 인사이드 이미지 다운로더",
	"permissions": [
		"downloads",
		"tabs",
		"webRequest",
		"storage"
	],
	"host_permissions": [
		"https://*.dcinside.com/*",
		"https://*.dcinside.co.kr/*"
	],
	"content_scripts": [
		{
			"matches": [
				"https://gall.dcinside.com/board/view*",
				"https://gall.dcinside.com/mini/board/view*"
			],
			"js": ["content.js"]
		}
	],
	"background": {
		"service_worker": "background.js"
	},
	"action": {
		"default_popup": "popup.html",
		"default_title": "옵션 설정"
	}
}

