{
	"manifest_version": 3,
	"name": "DC Extension",
	"version": "0.1",
	"description": "DC 인사이드 확장 프로그램",
	"permissions": [
		"downloads",
		"tabs",
		"scripting",
		"webRequest",
		"activeTab",
		"commands"
	],
	"host_permissions": [
		"https://*.dcinside.com/*",
		"https://*.dcinside.co.kr/*"
	],
	"content_scripts": [
		{
			"matches": [
				"https://gall.dcinside.com/board/view*",
				"https://gall.dcinside.com/board/view/*",
				"https://gall.dcinside.com/mini/board/view*",
				"https://gall.dcinside.com/mini/board/view/*"
			],
			"js": ["content.js"]
		}
	],
	"background": {
		"service_worker": "background.js"
	},
	"commands": {
		"IMG_DOWNLOAD": {
			"suggested_key": {
				"default": "Alt+S"
			},
			"description": "이미지 다운로드 시작"
		}
	}
}
